<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>X分割カルーセルメーカー</title>
  <style>
    body { font-family: sans-serif; max-width: 800px; margin: 20px auto; padding: 0 15px; color: #333; }
    .box { border: 2px dashed #ccc; padding: 20px; text-align: center; margin-bottom: 20px; border-radius: 8px; }
    .controls { display: flex; gap: 15px; flex-wrap: wrap; margin-bottom: 20px; background: #f5f5f5; padding: 15px; border-radius: 8px; }
    .control-item { display: flex; flex-direction: column; gap: 5px; }
    .recommend-badge { background: #1da1f2; color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.8em; }
    #previewContainer { display: flex; gap: 10px; overflow-x: auto; margin-top: 20px; padding-bottom: 10px; }
    .preview-item { flex: 0 0 auto; text-align: center; }
    .preview-item img { max-height: 250px; border: 1px solid #ddd; border-radius: 4px; }
    button { background: #1da1f2; color: white; border: none; padding: 10px 20px; border-radius: 20px; cursor: pointer; font-weight: bold; }
    button:hover { background: #0d8ddb; }
  </style>
</head>
<body>

  <h1>X分割カルーセルメーカー</h1>
  
  <div class="box">
    <input type="file" id="imageInput" accept="image/jpeg, image/png, image/webp">
  </div>

  <div id="settings" style="display:none;">
    <div class="controls">
      <div class="control-item">
        <label>分割数:</label>
        <select id="splitCount">
          <option value="2">2分割</option>
          <option value="3">3分割</option>
          <option value="4">4分割</option>
        </select>
      </div>

      <div class="control-item">
        <label>1コマの比率:</label>
        <select id="aspectRatio">
          <option value="1.0">1:1 (スクエア)</option>
          <option value="0.8">4:5 (縦長)</option>
          <option value="0.75">3:4 (縦長)</option>
          <option value="0.5625">9:16 (フル縦長)</option>
        </select>
      </div>

      <div class="control-item" style="justify-content: flex-end;">
        <span id="recommendText" class="recommend-badge"></span>
      </div>
    </div>

    <button id="processBtn">画像を分割・書き出し</button>
  </div>

  <div id="previewContainer"></div>

<script>
  let loadedImage = null;

  const ratios = [
    { label: '1:1', val: 1.0 },
    { label: '4:5', val: 0.8 },
    { label: '3:4', val: 0.75 },
    { label: '9:16', val: 9/16 }
  ];
  const counts = [2, 3, 4];

  // 画像読み込み処理
  document.getElementById('imageInput').addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;

    const img = new Image();
    img.onload = () => {
      loadedImage = img;
      document.getElementById('settings').style.display = 'block';
      autoSelectBestPattern(img.width, img.height);
    };
    img.src = URL.createObjectURL(file);
  });

  // 残存率の自動判定ロジック
  function autoSelectBestPattern(imgWidth, imgHeight) {
    const R = imgWidth / imgHeight; // 元画像比率
    let bestRetention = -1;
    let bestCount = 2;
    let bestRatioVal = 1.0;

    counts.forEach(count => {
      ratios.forEach(r => {
        const F = r.val * count; // 枠全体の比率
        const retention = Math.min(R, F) / Math.max(R, F); // 残存率計算式

        // 残存率が高いもの、同率なら分割数が多い（コマが縦長になる）方を優先
        if (retention > bestRetention || (Math.abs(retention - bestRetention) < 0.0001 && count > bestCount)) {
          bestRetention = retention;
          bestCount = count;
          bestRatioVal = r.val;
        }
      });
    });

    // UIに反映
    document.getElementById('splitCount').value = bestCount;
    document.getElementById('aspectRatio').value = bestRatioVal;
    document.getElementById('recommendText').innerText = 
      `おすすめ: ${bestCount}分割 (${(bestRetention * 100).toFixed(1)}% 残存)`;
  }

  // 画像のスライス切り抜き処理
  document.getElementById('processBtn').addEventListener('click', () => {
    if (!loadedImage) return;

    const count = parseInt(document.getElementById('splitCount').value);
    const aspect = parseFloat(document.getElementById('aspectRatio').value);
    const container = document.getElementById('previewContainer');
    container.innerHTML = '';

    const R = loadedImage.width / loadedImage.height;
    const F = aspect * count;

    let cropW, cropH, startX, startY;

    // クロップ範囲の決定（中央寄せ）
    if (R > F) {
      cropH = loadedImage.height;
      cropW = cropH * F;
      startX = (loadedImage.width - cropW) / 2;
      startY = 0;
    } else {
      cropW = loadedImage.width;
      cropH = cropW / F;
      startX = 0;
      startY = (loadedImage.height - cropH) / 2;
    }

    const pieceW = cropW / count;

    // 各コマを切り出してダウンロードリンクを生成
    for (let i = 0; i < count; i++) {
      const canvas = document.createElement('canvas');
      const piecePixelW = 1080; // 高画質出力用の幅固定
      const piecePixelH = piecePixelW / aspect;
      
      canvas.width = piecePixelW;
      canvas.height = piecePixelH;
      const ctx = canvas.getContext('2d');

      // ソースの切り抜き位置
      const sx = startX + (i * pieceW);
      const sy = startY;

      ctx.drawImage(loadedImage, sx, sy, pieceW, cropH, 0, 0, piecePixelW, piecePixelH);

      const dataUrl = canvas.toDataURL('image/jpeg', 0.9);

      // プレビュー表示
      const itemDiv = document.createElement('div');
      itemDiv.className = 'preview-item';
      
      const imgElem = document.createElement('img');
      imgElem.src = dataUrl;
      
      const link = document.createElement('a');
      link.href = dataUrl;
      link.download = `x_split_${i + 1}.jpg`;
      link.innerText = `${i + 1}枚目を保存`;
      link.style.display = 'block';
      link.style.marginTop = '5px';

      itemDiv.appendChild(imgElem);
      itemDiv.appendChild(link);
      container.appendChild(itemDiv);
    }
  });
</script>
</body>
</html>
